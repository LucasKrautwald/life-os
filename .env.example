# ----------------------------------------------------------------
# Life OS — environment variables
# Copy to `.env.local` and fill in. The app runs in demo mode
# (mock data, no auth) until Supabase is configured.
# ----------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude (genera los 3 todos del día)
ANTHROPIC_API_KEY=

# Garmin Connect
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=

# Yahoo Finance (precios de acciones)
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# Google Sheets (portafolio) — service account
# El private key va entre comillas dobles y conserva los \n literales.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=1_lIcwT-9Npo7g_wZ0DEyP1wLW2-yqIzE8NJLfSl9CCQ
